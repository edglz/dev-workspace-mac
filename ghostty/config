# dev-workspace-mac — Ghostty config
# Lives at ~/.config/ghostty/config (symlinked by install.sh).
# Tuned for: Powerlevel10k (Nerd Font required), backend/docker dev,
# mobile workflows (split panes), Claude Code.

# ── Font ──────────────────────────────────────────────────────────────────
# MesloLGS NF is what p10k explicitly recommends.
# Installed via `brew install --cask font-meslo-lg-nerd-font`.
font-family = "MesloLGS NF"
font-size = 14
font-thicken = true
# Adjust line height for two-line prompts to breathe.
adjust-cell-height = 8%

# ── Theme — dark with cyan/yellow/magenta accents matching the omp theme ─
theme = "GruvboxDarkHard"
# Override theme to match the windows workspace palette more closely.
background = "1a1b26"
foreground = "c0caf5"
cursor-color = "7aa2f7"
selection-background = "33467c"
selection-foreground = "c0caf5"

# ANSI palette (Tokyo Night-ish, tweaked so cyan path / yellow git pop)
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# ── Window ────────────────────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = true
window-title-font-family = "MesloLGS NF"
macos-titlebar-style = transparent
macos-non-native-fullscreen = visible-menu
window-save-state = always
confirm-close-surface = false

# Slight background blur — nicer on Apple Silicon, free perf-wise.
background-opacity = 0.96
background-blur-radius = 20

# Scrollback for long docker/k8s logs.
scrollback-limit = 100000

# ── Cursor + bell ─────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Mouse / clipboard ─────────────────────────────────────────────────────
copy-on-select = clipboard
mouse-hide-while-typing = true

# ── Keybindings: tmux-ish split + tab navigation ──────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+k=clear_screen

# Quick zoom on the active split (helpful when reading docker/k8s output).
keybind = cmd+shift+z=toggle_split_zoom
keybind = cmd+enter=toggle_fullscreen

# Quick open Claude Code in a new split (assumes `claude` is on PATH).
keybind = cmd+shift+c=text:claude\n
